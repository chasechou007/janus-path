  </entry>
  <entry>
    <title>如果没人写代码了，AI也会开始变差</title>
    <link href="https://blog.janus-path.com/2026/03/24/%E5%A6%82%E6%9E%9C%E6%B2%A1%E4%BA%BA%E5%86%99%E4%BB%A3%E7%A0%81%E4%BA%86%EF%BC%8CAI%E4%B9%9F%E4%BC%9A%E5%BC%80%E5%A7%8B%E5%8F%98%E5%B7%AE/"/>
    <id>https://blog.janus-path.com/2026/03/24/%E5%A6%82%E6%9E%9C%E6%B2%A1%E4%BA%BA%E5%86%99%E4%BB%A3%E7%A0%81%E4%BA%86%EF%BC%8CAI%E4%B9%9F%E4%BC%9A%E5%BC%80%E5%A7%8B%E5%8F%98%E5%B7%AE/</id>
