{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node tools/build-bilingual.js",
    "build:zh": "hexo clean --config _config.yml,_config.zh-CN.yml && hexo generate --config _config.yml,_config.zh-CN.yml && npm run optimize:images",
    "build:en": "hexo clean --config _config.yml,_config.en.yml && hexo generate --config _config.yml,_config.en.yml && npm run optimize:images",
    "optimize:images": "node tools/optimize-images.js",
    "test:images": "node --test tools/optimize-images.test.js",
    "check:bilingual": "node tools/verify-bilingual-build.js",
    "clean": "hexo clean",
    "deploy": "npm run build && hexo deploy",
    "server": "npm run build && hexo server --static"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "pnpm": {
    "overrides": {}
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-robotstxt": "^0.2.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0"
  },
  "engines": {
    "node": ">= 20.9.0",
    "npm": ">= 10.1.0"
  },
  "volta": {
    "node": "22.15.0"
  },
  "devDependencies": {
    "cheerio": "1.0.0",
    "sharp": "^0.34.5"
  }
}
