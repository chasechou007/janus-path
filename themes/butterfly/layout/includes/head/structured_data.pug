if theme.structured_data
  - let jsonLdScript = ''
  if page.layout === 'post'
    -
      // https://developers.google.com/search/docs/appearance/structured-data/article

      const title = page.title
      const url = full_url_for(urlNoIndex(null, false, false))
      const imageVal = page.cover_type === 'img' ? page.cover : theme.avatar.img
      const image = imageVal ? full_url_for(imageVal) : ''
      const description = truncate(page.description || page.content || page.title || config.description, 150).trim()
      const datePublished = page.date.toISOString()
      const dateModified = (page.updated || page.date).toISOString()
      const author = page.copyright_author || config.author
      const authorHrefVal = page.copyright_author_href || config.author_url || theme.post_copyright.author_href || config.url
      const authorHref = full_url_for(authorHrefVal)
      const authorSameAs = (config.author_same_as || [authorHrefVal]).map(item => full_url_for(item))
      const keywords = Array.isArray(page.keywords) ? page.keywords.join(', ') : page.keywords
      const articleSections = page.categories && page.categories.toArray
        ? page.categories.toArray().map(category => category.name)
        : []
      const publisherLogoVal = theme.favicon || config.favicon || theme.avatar.img
      const publisherLogo = publisherLogoVal ? full_url_for(publisherLogoVal) : undefined
      const siteUrl = full_url_for('/')

      const jsonLd = {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title,
        "url": url,
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": url
        },
        "description": description,
        "image": image,
        "keywords": keywords,
        "articleSection": articleSections.length ? articleSections : undefined,
        "inLanguage": page.lang || page.language || config.language || "zh-CN",
        "datePublished": datePublished,
        "dateModified": dateModified,
        "isPartOf": {
          "@type": "Blog",
          "@id": `${siteUrl}#blog`,
          "name": config.title,
          "url": siteUrl
        },
        "author": [{
          "@type": "Person",
          "name": author,
          "url": authorHref,
          "sameAs": authorSameAs
        }],
        "publisher": {
          "@type": "Organization",
          "name": config.title,
          "url": siteUrl,
          "logo": publisherLogo ? {
            "@type": "ImageObject",
            "url": publisherLogo
          } : undefined
        }
      }

      jsonLdScript = JSON.stringify(jsonLd, null, 2)
    -

  else if is_home() && (!page.current || page.current === 1)
    -
      // https://developers.google.com/search/docs/appearance/site-names#website

      const jsonLd = {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": config.title,
        "alternateName": config.subtitle || undefined,
        "url": full_url_for('/'),
        "description": truncate(config.description || config.title, 150).trim(),
        "inLanguage": page.lang || page.language || config.language || "zh-CN",
        "publisher": {
          "@type": "Person",
          "name": config.author,
          "url": full_url_for(config.author_url || config.url),
          "sameAs": (config.author_same_as || []).map(item => full_url_for(item))
        }
      }

      jsonLdScript = JSON.stringify(jsonLd, null, 2)
    -

  if jsonLdScript
    script(type="application/ld+json").
      !{jsonLdScript}
