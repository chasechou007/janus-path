if theme.menu
  .menus_items
    - const activeMenu = theme.localized_menu || theme.menu
    each value, label in activeMenu
      if typeof value !== 'object'
        .menus_item
          - const [link, icon] = value.split('||').map(part => trim(part))
          a.site-page(href=url_for(link))
            if icon
              i.fa-fw(class=icon)
            span= ' ' + label
      else
        .menus_item
          - const [groupLabel, groupIcon, groupClass] = label.split('||').map(part => trim(part))
          - const hideClass = groupClass === 'hide' ? 'hide' : ''
          span.site-page.group(class=hideClass)
            if groupIcon
              i.fa-fw(class=groupIcon)
            span= ' ' + groupLabel
            i.fas.fa-chevron-down
          ul.menus_item_child
            each val, lab in value
              - const [childLink, childIcon] = val.split('||').map(part => trim(part))
              li
                a.site-page.child(href=url_for(childLink))
                  if childIcon
                    i.fa-fw(class=childIcon)
                  span= ' ' + lab
    - const localeSwitch = bilingual_switch(page)
    if localeSwitch
      .menus_item
        a.site-page.bilingual-switch(
          href=localeSwitch.href
          hreflang=localeSwitch.hreflang
          lang=localeSwitch.hreflang
          title=localeSwitch.title
          aria-label=localeSwitch.title
          data-translation-available=localeSwitch.available ? 'true' : 'false'
        )
          i.fas.fa-language.fa-fw
          span= ' ' + localeSwitch.label
