#local-search
  dialog#jp-search-dialog.search-dialog(aria-labelledby='jp-search-title')
    .search-nav
      span#jp-search-title.search-dialog-title= _p('search.title')
      button.search-close-button(type='button' aria-label=_p('search.local_search.close'))
        i.fas.fa-times(aria-hidden='true')
    label.search-input-label(for='jp-search-input')= _p('search.local_search.label')
    input#jp-search-input(type='search' autocomplete='off' spellcheck='false' placeholder=theme.search.placeholder || _p('search.input_placeholder') aria-describedby='jp-search-status')
    p#jp-search-status(role='status' aria-live='polite' aria-atomic='true')= _p('search.local_search.initial')
    button#jp-search-retry(type='button' hidden)= _p('search.local_search.retry')
    ol#local-search-results(aria-label=_p('search.title'))
  script(src=url_for(theme.asset.local_search) defer)
